# Optional operator settings. Relative paths are rejected. Never put credentials here.
# GPU_AGENT_CUDA_ROOT=/absolute/path/to/project-conda-env
# GPU_AGENT_CUDA_BIN=/absolute/path/to/project-conda-env/bin
# This file is a template, not automatically loaded by the CLI.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=<operator-selected-model>
# OPENAI_API_KEY is consumed from the controller environment; never put its value here.
# GPU_AGENT_STORE_FALSE_SUPPORTED=1  # Required capability declaration for compatible endpoints.
# GPU_AGENT_RUN_ROOT=/absolute/path/to/public/runs
# GPU_AGENT_EVALUATOR_ROOT=/absolute/path/to/separate/evaluator
# GPU_AGENT_KNOWLEDGE_INDEX=/absolute/path/to/ingested/index.json
# GPU_AGENT_KNOWLEDGE_VERSION=cuda=13.0;compute-sanitizer=13.0
